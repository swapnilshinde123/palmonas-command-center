# --- Database (Neon) ---
# Pooled URL (host contains "-pooler") for the app; direct URL for migrations and live updates (LISTEN/NOTIFY).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Auth ---
# Public HTTPS address of the app, e.g. https://palmonas-ops.onrender.com
NEXTAUTH_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Random 32+ byte secret. Render generates one automatically from render.yaml.
NEXTAUTH_SECRET=

# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional comma-separated allow-list, e.g. palmonas.com
ALLOWED_EMAIL_DOMAINS=
# false = Google is the only way in (recommended once Google works). Ignored if Google isn't configured.
PASSWORD_LOGIN=true

# First Owner, created on first deploy. With Google, use your Google email and leave the password empty.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Workspace Owner
# Demo team + tasks on an empty database (local only; never in production).
SEED_SAMPLE=false

# --- Email (Gmail / Google Workspace SMTP with an App Password works) ---
# Delivery is also gated in Settings → Notifications and stays OFF until switched on there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Palmonas Ops <ops@example.com>"

# --- Behaviour ---
BUSINESS_TZ=Asia/Kolkata
INVITE_TTL_DAYS=7
INVITE_RESEND_COOLDOWN_SECONDS=60
# Background jobs (recurring tasks, email queue, digests) run inside the web process unless false.
RUN_WORKER=true
